<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>UnzipTool.App</RootNamespace>
    <AssemblyName>SteadyZip</AssemblyName>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnzipTool.Core\UnzipTool.Core.csproj" />
    <!-- 7z.dll is embedded so the app can be published as a single self-contained exe;
         it is extracted to %LOCALAPPDATA%\SteadyZip at startup (see NativeBootstrap). -->
    <EmbeddedResource Include="..\..\deps\7z\7z.dll" LogicalName="UnzipTool.App.sevenzip_native" />
  </ItemGroup>

</Project>
