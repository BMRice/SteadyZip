<local:AppWindow x:Class="UnzipTool.App.PasswordWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:UnzipTool.App"
                 Style="{StaticResource Window.Dialog}"
                 Title="密码库" Width="440" Height="420" WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource Brush.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="解压加密压缩包时，按下列顺序自动尝试"
                           Style="{StaticResource Text.Hint}" />

                <ListBox Grid.Row="1" x:Name="List" Margin="0,10,0,0" MouseDoubleClick="OnDoubleClick"
                         AutomationProperties.Name="已保存的密码">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Style="{StaticResource Icon}"
                                      Data="{StaticResource Icon.Lock}" />

                                <TextBlock Grid.Column="1" Text="{Binding Display}" Margin="8,0,8,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <ToggleButton Grid.Column="2" Style="{StaticResource Button.ToggleIcon}"
                                              IsChecked="{Binding IsRevealed, Mode=TwoWay}"
                                              ToolTip="显示 / 隐藏密码"
                                              AutomationProperties.Name="显示密码">
                                    <Path>
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Data" Value="{StaticResource Icon.Eye}" />
                                                <Setter Property="Stroke"
                                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRevealed}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Icon.EyeOff}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </ToggleButton>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="EditBox" Margin="0,0,8,0"
                             AutomationProperties.Name="新密码" />
                    <Button Grid.Column="1" Content="添加" MinWidth="64" Click="OnAdd" />
                    <Button Grid.Column="2" Content="更新" MinWidth="64" Margin="8,0,0,0" Click="OnUpdate" />
                    <Button Grid.Column="3" Content="删除" MinWidth="64" Margin="8,0,0,0" Click="OnRemove" />
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Brush.Background}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <TextBlock Text="DPAPI 加密，绑定当前 Windows 用户" Style="{StaticResource Text.Hint}"
                               VerticalAlignment="Center" />
                    <Button Content="关闭" MinWidth="80" HorizontalAlignment="Right" Click="OnClose" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:AppWindow>
