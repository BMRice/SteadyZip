<Window x:Class="UnzipTool.App.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码库" Height="340" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="DPAPI 加密存储，绑定当前 Windows 用户" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="关闭" Width="70" Click="OnClose"/>
        </StackPanel>

        <ListBox x:Name="List" Margin="0,0,0,8" MouseDoubleClick="OnDoubleClick"/>

        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="EditBox" Width="240"/>
            <Button Content="添加" Width="60" Margin="8,0,0,0" Click="OnAdd"/>
            <Button Content="更新" Width="60" Margin="8,0,0,0" Click="OnUpdate"/>
            <Button Content="删除" Width="60" Margin="8,0,0,0" Click="OnRemove"/>
        </StackPanel>
    </DockPanel>
</Window>
