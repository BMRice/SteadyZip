<local:AppWindow x:Class="UnzipTool.App.MessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:UnzipTool.App"
                 Style="{StaticResource Window.Dialog}"
                 Title="提示" Width="440" SizeToContent="Height" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource Brush.Surface}" Padding="20,18,20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path x:Name="KindIcon" Grid.Column="0" Width="24" Height="24" Stretch="Uniform"
                      Margin="0,1,14,0" VerticalAlignment="Top"
                      Fill="{StaticResource Brush.Transparent}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="38,12,0,0">
                <Button x:Name="DetailsToggle" Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left"
                        MinWidth="0" Height="24" Padding="4,0" Click="OnToggleDetails"
                        AutomationProperties.Name="详细信息">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="DetailsChevron" Style="{StaticResource Icon}" Width="12" Height="12"
                              Stretch="Uniform" Data="{StaticResource Icon.ChevronDown}" StrokeThickness="1.5" />
                        <TextBlock Text="详细信息" Margin="4,0,0,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource Font.Size.Caption}" />
                    </StackPanel>
                </Button>

                <Border x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="{StaticResource Brush.Background}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Thin}"
                        CornerRadius="{StaticResource Radius.Control}" Padding="10,8">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DetailsText" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="取消" MinWidth="88" Margin="0,0,8,0"
                        Click="OnCancel" IsCancel="True" />
                <Button x:Name="OkButton" Content="确定" MinWidth="88" IsDefault="True"
                        Style="{StaticResource Button.Primary}" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</local:AppWindow>
