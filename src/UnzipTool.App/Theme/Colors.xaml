<!-- Design tokens for the SteadyZip UI. See docs/ui-design.md §2. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 2.1 颜色 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#0078D4" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#106EBE" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#005A9E" />
    <SolidColorBrush x:Key="Brush.HoverSurface" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.SelectedSurface" Color="#E8F1FB" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5D5D5D" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A0A0A0" />
    <SolidColorBrush x:Key="Brush.ControlDisabled" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#A82617" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#9D5D00" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <!-- 2.2 圆角 -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Surface">8</CornerRadius>

    <!-- 2.3 间距与尺寸 -->
    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.16">16</sys:Double>
    <sys:Double x:Key="Space.24">24</sys:Double>
    <sys:Double x:Key="Size.ControlHeight">32</sys:Double>
    <sys:Double x:Key="Size.TitleBarHeight">32</sys:Double>
    <sys:Double x:Key="Size.CommandBarHeight">44</sys:Double>
    <sys:Double x:Key="Size.ListRowHeight">30</sys:Double>
    <sys:Double x:Key="Size.StatusBarHeight">24</sys:Double>

    <!-- 2.4 字体 -->
    <FontFamily x:Key="Font.UI">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">15</sys:Double>
    <sys:Double x:Key="Font.Size.Title">20</sys:Double>

    <!-- 2.5 边框 -->
    <Thickness x:Key="Border.Thin">1</Thickness>
</ResourceDictionary>
