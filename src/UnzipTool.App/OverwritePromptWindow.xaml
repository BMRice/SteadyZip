<local:AppWindow x:Class="UnzipTool.App.OverwritePromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:UnzipTool.App"
                 Style="{StaticResource Window.Dialog}"
                 Title="目标已存在" Width="500" Height="220" WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource Brush.Surface}" Padding="20,18,20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Top"
                      Margin="0,1,14,0" Data="{StaticResource Icon.Warning}"
                      Fill="{StaticResource Brush.Transparent}" Stroke="{StaticResource Brush.Warning}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="目标文件已存在" Style="{StaticResource Text.Subtitle}" />

                    <!-- 中间省略：目录可截断，文件名始终完整可见 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="DirText" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" x:Name="FileText" Style="{StaticResource Text.Body}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    </Grid>
                </StackPanel>
            </Grid>

            <CheckBox Grid.Row="1" x:Name="ApplyAll" Content="全部套用" Margin="38,14,0,0" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="跳过" MinWidth="84" IsCancel="True" Click="OnSkip" />
                <Button Content="改名" MinWidth="84" Margin="8,0,0,0" Click="OnRename" />
                <Button Content="覆盖" MinWidth="84" Margin="8,0,0,0" Style="{StaticResource Button.Danger}"
                        Click="OnOverwrite" />
            </StackPanel>
        </Grid>
    </Border>
</local:AppWindow>
