<local:AppWindow x:Class="UnzipTool.App.PasswordPromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:UnzipTool.App"
                 Style="{StaticResource Window.Dialog}"
                 Title="需要密码" Width="440" SizeToContent="Height" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Background="{StaticResource Brush.Surface}" Padding="20,18,20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Top"
                      Margin="0,1,14,0" Data="{StaticResource Icon.Lock}"
                      Fill="{StaticResource Brush.Transparent}" Stroke="{StaticResource Brush.Accent}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="该压缩包已加密，请输入密码。" Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="38,14,0,0">
                <PasswordBox x:Name="Input" AutomationProperties.Name="压缩包密码" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" MinWidth="88" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                <Button Content="确定" MinWidth="88" IsDefault="True"
                        Style="{StaticResource Button.Primary}" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</local:AppWindow>
