<Window x:Class="UnzipTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解压软件" Height="640" Width="920"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="打开..." Click="OnOpenClick"/>
                <Button Content="测试" Click="OnTestClick"/>
                <Button Content="解压" Click="OnExtractClick"/>
                <Button Content="压缩..." Click="OnCompressClick"/>
                <Button Content="密码库..." Click="OnPasswordsClick"/>
                <Separator/>
                <Button Content="全选" Click="OnSelectAll"/>
                <Button Content="全不选" Click="OnSelectNone"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="拖入压缩包或点“打开”。"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="EngineText" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Height="20" Minimum="0" Maximum="1"/>
            <Button Grid.Column="1" x:Name="CancelButton" Content="取消" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnCancelClick"/>
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8" Margin="8,0,8,4">
            <WrapPanel>
                <TextBlock Text="目标:" VerticalAlignment="Center"/>
                <TextBox x:Name="DestBox" Width="220" Margin="4,0" VerticalAlignment="Center"/>
                <Button Content="浏览..." Click="OnBrowseDest" VerticalAlignment="Center"/>

                <TextBlock Text="解压到:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox x:Name="SubfolderBox" Width="120" SelectedIndex="0">
                    <ComboBoxItem Content="同名子文件夹"/>
                    <ComboBoxItem Content="此处"/>
                </ComboBox>

                <TextBlock Text="覆盖:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox x:Name="OverwriteBox" Width="100" SelectedIndex="0">
                    <ComboBoxItem Content="询问"/>
                    <ComboBoxItem Content="跳过"/>
                    <ComboBoxItem Content="覆盖"/>
                    <ComboBoxItem Content="自动改名"/>
                </ComboBox>

                <CheckBox x:Name="DeleteAfterBox" Content="解压后删除原包" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <CheckBox x:Name="DeleteVolumesBox" Content="分卷边解压边删卷" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="分卷压缩包：解出某卷数据后立即永久删除该卷（不进回收站）。"/>
            </WrapPanel>
        </Border>

        <ListView x:Name="EntryList" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="28">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="名称" Width="520" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Kind}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
