<local:AppWindow x:Class="UnzipTool.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:UnzipTool.App"
                 Style="{StaticResource Window.App}"
                 Title="解压软件" Width="1040" Height="700" MinWidth="820" MinHeight="520"
                 AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ============================ 命令栏 ============================ -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Background}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenButton" Style="{StaticResource Button.Command}" Click="OnOpenClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Command}" Data="{StaticResource Icon.Open}" />
                            <TextBlock Text="打开" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TestButton" Style="{StaticResource Button.Command}" IsEnabled="False"
                            Click="OnTestClick" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Command}" Data="{StaticResource Icon.Test}" />
                            <TextBlock Text="测试" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExtractCommandButton" Style="{StaticResource Button.Command}" IsEnabled="False"
                            Click="OnExtractClick" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Command}" Data="{StaticResource Icon.Extract}" />
                            <TextBlock Text="解压" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CompressCommandButton" Style="{StaticResource Button.Command}" Click="OnCompressClick" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Command}" Data="{StaticResource Icon.Compress}" />
                            <TextBlock Text="压缩" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PasswordsButton" Style="{StaticResource Button.Command}" Click="OnPasswordsClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Command}" Data="{StaticResource Icon.Key}" />
                            <TextBlock Text="密码库" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="MoreButton" Style="{StaticResource Button.Command}" Width="36" Padding="0"
                            Margin="2,0,0,0" ToolTip="更多" Click="OnMoreClick">
                        <Path Style="{StaticResource Icon.CommandFilled}" Data="{StaticResource Icon.More}" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <MenuItem Header="全选" Click="OnSelectAll" />
                                <MenuItem Header="全不选" Click="OnSelectNone" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ 信息条 ============================ -->
        <Border x:Name="InfoBar" Grid.Row="1" Height="32" Visibility="Collapsed"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="InfoName" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                           MaxWidth="420" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InfoMeta" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <Border x:Name="VolumeBadge" Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Volume}" />
                        <TextBlock x:Name="VolumeText" Style="{StaticResource Badge.Text}" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="EncryptBadge" Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Lock}" />
                        <TextBlock Text="加密" Style="{StaticResource Badge.Text}" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================ 文件列表 ============================ -->
        <Grid Grid.Row="2">
            <ListView x:Name="EntryList" SelectionMode="Extended" SizeChanged="OnEntryListSizeChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="36">
                            <GridViewColumn.Header>
                                <CheckBox x:Name="HeaderCheckBox" Padding="0"
                                          IsChecked="{Binding SelectAll, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                          ToolTip="全选 / 全不选" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn x:Name="NameColumn" Header="名称" Width="400">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Data" Value="{StaticResource Icon.File}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Entry.IsDirectory}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Folder}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding DisplayName}" Margin="8,0,10,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="大小" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="压缩后" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PackedText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="类型" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Kind}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="修改时间" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimeText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Path Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"
                      Data="{StaticResource Icon.Inbox}" Fill="{StaticResource Brush.Transparent}"
                      Stroke="{StaticResource Brush.TextTertiary}" StrokeThickness="1.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <TextBlock Text="拖入压缩包，或点上方“打开”" Style="{StaticResource Text.Hint}"
                           Margin="0,14,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================ 操作区 ============================ -->
        <Border Grid.Row="3" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="目标" Style="{StaticResource Text.Label}"
                           Margin="0,0,8,0" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DestBox" Margin="0,0,8,0" />
                <Button Grid.Row="0" Grid.Column="2" Content="浏览..." MinWidth="76" Click="OnBrowseDest"
                        Margin="0,0,24,0" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="解压到" Style="{StaticResource Text.Label}"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Row="0" Grid.Column="4" x:Name="SubfolderBox" Width="150" SelectedIndex="0">
                    <ComboBoxItem Content="同名子文件夹" />
                    <ComboBoxItem Content="此处" />
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="覆盖" Style="{StaticResource Text.Label}"
                           Margin="0,10,8,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <ComboBox x:Name="OverwriteBox" Width="120" SelectedIndex="0" Margin="0,0,24,0">
                        <ComboBoxItem Content="询问" />
                        <ComboBoxItem Content="跳过" />
                        <ComboBoxItem Content="覆盖" />
                        <ComboBoxItem Content="自动改名" />
                    </ComboBox>
                    <CheckBox x:Name="DeleteAfterBox" Content="解压后删除原包" Margin="0,0,24,0" />
                    <CheckBox x:Name="DeleteVolumesBox" Content="分卷边解压边删卷"
                              ToolTip="分卷压缩包：解出某卷数据后立即永久删除该卷（不进回收站）。" />
                </StackPanel>

                <Button Grid.Row="1" Grid.Column="4" x:Name="ExtractButton" Content="解压" MinWidth="104"
                        Style="{StaticResource Button.Primary}" Margin="24,10,0,0" IsEnabled="False"
                        Click="OnExtractClick" />
            </Grid>
        </Border>

        <!-- ============================ 进度区 ============================ -->
        <Border x:Name="ProgressArea" Grid.Row="4" Visibility="Collapsed"
                Background="{StaticResource Brush.Background}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" VerticalAlignment="Center" />

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                               Margin="0,0,96,0" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CancelButton" Content="取消" MinWidth="80" HorizontalAlignment="Right"
                            IsEnabled="False" Click="OnCancelClick" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ 状态栏 ============================ -->
        <Border Grid.Row="5" Background="{StaticResource Brush.Background}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="CountsText" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineText" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</local:AppWindow>
