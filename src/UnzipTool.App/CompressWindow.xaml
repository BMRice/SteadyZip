<Window x:Class="UnzipTool.App.CompressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="压缩" Height="460" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ProgressBar x:Name="Progress" Width="180" Height="20" Maximum="1" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="压缩" Width="90" Click="OnCompress"/>
            <Button Content="取消" Width="70" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="要压缩的内容:" FontWeight="Bold"/>
                <ListBox x:Name="SourceList" Height="110" Margin="0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="添加文件..." Click="OnAddFiles"/>
                    <Button Content="添加文件夹..." Margin="8,0,0,0" Click="OnAddFolder"/>
                    <Button Content="移除" Margin="8,0,0,0" Click="OnRemove"/>
                </StackPanel>

                <TextBlock Text="保存为:" FontWeight="Bold" Margin="0,16,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="DestBox" Width="400"/>
                    <Button Content="浏览..." Margin="8,0,0,0" Click="OnBrowse"/>
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="格式:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FormatBox" Width="120" HorizontalAlignment="Left" SelectedIndex="1">
                        <ComboBoxItem Content="ZIP"/>
                        <ComboBoxItem Content="7z"/>
                        <ComboBoxItem x:Name="RarItem" Content="RAR"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="压缩级别:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LevelBox" Width="120" HorizontalAlignment="Left" SelectedIndex="2">
                        <ComboBoxItem Content="仅存"/>
                        <ComboBoxItem Content="最快"/>
                        <ComboBoxItem Content="标准"/>
                        <ComboBoxItem Content="最大"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="加密密码:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Width="200" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="分卷大小:" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="VolumeBox" Width="120" SelectedIndex="0">
                            <ComboBoxItem Content="不拆分"/>
                            <ComboBoxItem Content="700 MB"/>
                            <ComboBoxItem Content="4 GB"/>
                            <ComboBoxItem Content="自定义"/>
                        </ComboBox>
                        <TextBox x:Name="VolumeCustom" Width="120" Margin="8,0,0,0" ToolTip="如 100MB / 1.5GB / 500KB" IsEnabled="False"/>
                    </StackPanel>

                    <CheckBox Grid.Row="4" Grid.Column="1" x:Name="SolidBox" Content="固实压缩（仅 7z）" Margin="0,8,0,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
